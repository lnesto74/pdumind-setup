SNMPPDU-MIB DEFINITIONS ::= BEGIN

IMPORTS

    MODULE-IDENTITY, OBJECT-TYPE, Integer32,
    NOTIFICATION-TYPE                       FROM SNMPv2-SMI
    SnmpAdminString                         FROM SNMP-FRAMEWORK-MIB
    RowStatus, StorageType ,DisplayString   FROM SNMPv2-TC;

pdu OBJECT IDENTIFIER ::= { enterprises 23273}
npdu OBJECT IDENTIFIER ::= { pdu 3 }


master OBJECT IDENTIFIER ::= { npdu 1 }
masterpdu OBJECT IDENTIFIER ::= { master 1 }
masterInformation OBJECT IDENTIFIER ::= { masterpdu 1 }
masterP1 OBJECT IDENTIFIER ::= { masterpdu 2 }
masterP2 OBJECT IDENTIFIER ::= { masterpdu 3 }
masterP3 OBJECT IDENTIFIER ::= { masterpdu 4 }
masterOutputName OBJECT IDENTIFIER ::= { masterpdu 5 }
masterOutputStatus OBJECT IDENTIFIER ::= { masterpdu 6 }
masterOutputCurrent OBJECT IDENTIFIER ::= { masterpdu 7 }
masterOutputEnergy OBJECT IDENTIFIER ::= { masterpdu 10 }
masterSerson OBJECT IDENTIFIER ::= { masterpdu 11 }
masterGroup OBJECT IDENTIFIER ::= { masterpdu 13 }

MasterDeviceName OBJECT-TYPE
    SYNTAX DisplayString (SIZE (255))
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION
            "device name."
    ::= { masterInformation 1 }
    
