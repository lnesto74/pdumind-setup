# PDUMind Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (optional - for AI agent features)
# Leave blank if not using AI features
OPENAI_API_KEY=

# Hub coordinator — LAN IP for viewer share URL (auto-detected by install-windows.ps1)
# HUB_LAN_IP=192.168.1.50
# HUB_PORT=3000

# Production Stencil + Switchboard (Neural Ops). Customer installs should set this.
# PDUMIND_OPS_ENABLED=1

# Mac demo mode ONLY — never enable on customer machines (scripts/setup-demo-mac.sh)
# PDUMIND_DEMO_ENABLED=1
# DEMO_USERNAME=demo
# DEMO_PASSWORD=demo

# SNMP Configuration (optional - defaults shown)
# MAX_SNMP_THREADS=12
# SNMP_BATCH_SIZE=2
# OUTLET_BASE_TIMEOUT=3
# OUTLET_MAX_RETRIES=2
